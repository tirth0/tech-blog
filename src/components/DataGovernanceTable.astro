---
export interface StackLayer {
  num: string;
  label: string;
  accent: string;
  tools?: string;
}

const reasoning: StackLayer = {
  num: '05',
  label: 'Reasoning',
  accent: '#8b5cf6',
  tools: 'LLMs',
};

const harnessLayers: StackLayer[] = [
  {
    num: '04',
    label: 'Semantic Layer',
    accent: '#fda4af',
    tools: 'dbt · Snowflake · Arctic · Cube · Databricks',
  },
  {
    num: '03',
    label: 'Semantic - Query Translator',
    accent: '#fca5a5',
    tools: '',
  },
];

const storage: StackLayer = {
  num: '02',
  label: 'Storage',
  accent: '#60a5fa',
  tools: 'Databases',
};

const dataOrigination: StackLayer = {
  num: '01',
  label: 'Data Origination',
  accent: '#94a3b8',
  tools: 'ERP · CRM · HRIS · IoT',
};

const governanceAccent = '#f59e0b';
const harnessAccent = '#fb7185';
---

<div class="stack-wrap">
  <div class="stack-inner">
    <fieldset
      class="frame frame-governance"
      style={`border-color:${governanceAccent};`}
    >
      <legend class="tab" style={`border-color:${governanceAccent};`}>
        <span
          class="tab-label"
          style={`color:${governanceAccent};`}
        >
          Governance
        </span>
      </legend>

      <div class="layer-column">
        <!-- Reasoning -->
        <div
          class="layer-row"
          style={`--layer-accent:${reasoning.accent}; border-color:#8b5cf6aa; background:linear-gradient(90deg, ${reasoning.accent}22, transparent 60%);`}
        >
          <div class="layer-left">
            <span
              class="badge"
              style={`color:${reasoning.accent}; border-color:${reasoning.accent};`}
            >
              {reasoning.num}
            </span>

            <span class="layer-label">
              {reasoning.label}
            </span>
          </div>

          {
            reasoning.tools && (
              <span class="layer-tools">
                {reasoning.tools}
              </span>
            )
          }
        </div>

        <!-- Harness -->
        <fieldset
          class="frame frame-harness"
          style={`border-color:${harnessAccent};`}
        >
          <legend class="tab" style={`border-color:${harnessAccent};`}>
            <span
              class="tab-label"
              style={`color:${harnessAccent};`}
            >
              Harness
            </span>
          </legend>

          <div class="layer-column">
            {
              harnessLayers.map((layer) => (
                <div
                  class="layer-row harness-layer"
                  style={`--layer-accent:${harnessAccent}; border-color:${layer.accent}; background:linear-gradient(90deg, ${layer.accent}22, transparent 60%);`}
                >
                  <div class="layer-left">
                    <span class="badge">
                      {layer.num}
                    </span>

                    <span class="layer-label">
                      {layer.label}
                    </span>
                  </div>

                  {
                    layer.tools && (
                      <span class="layer-tools">
                        {layer.tools}
                      </span>
                    )
                  }
                </div>
              ))
            }
          </div>
        </fieldset>

        <!-- Storage -->
        <div
          class="layer-row"
          style={`--layer-accent:${storage.accent}; border-color:${storage.accent}; background:linear-gradient(90deg, ${storage.accent}22, transparent 60%);`}
        >
          <div class="layer-left">
            <span
              class="badge"
              style={`color:${storage.accent}; border-color:${storage.accent};`}
            >
              {storage.num}
            </span>

            <span class="layer-label">
              {storage.label}
            </span>
          </div>

          {
            storage.tools && (
              <span class="layer-tools">
                {storage.tools}
              </span>
            )
          }
        </div>

        <!-- Data Origination -->
        <div
          class="layer-row data-origination"
          style={`border-color:${dataOrigination.accent}; background:linear-gradient(90deg, ${dataOrigination.accent}22, transparent 60%);`}
        >
          <div class="layer-left">
            <span class="badge">
              {dataOrigination.num}
            </span>

            <span class="layer-label">
              {dataOrigination.label}
            </span>
          </div>

          {
            dataOrigination.tools && (
              <span class="layer-tools">
                {dataOrigination.tools}
              </span>
            )
          }
        </div>
      </div>
    </fieldset>
  </div>
</div>

<style>
  .stack-wrap {
    padding: 48px 16px;
    display: flex;
    justify-content: center;
    font-family: inherit;
    color: var(--foreground, currentColor);
  }

  .stack-inner {
    position: relative;
    width: 100%;
    max-width: 620px;
    color: var(--foreground, currentColor);
  }

  fieldset.frame {
    min-width: 0;
    margin: 0;
    border: 2px dashed;
    border-radius: 10px;
    padding: 12px 16px 16px 16px;
    color: var(--foreground, currentColor);
  }

  .frame-governance {
    padding: 14px 18px 18px 18px;
  }

  .frame-harness {
    padding: 10px 14px 14px 14px;
  }

  legend.tab {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 14px;
    padding: 2px 10px;
    border: 1px solid;
    border-radius: 4px;
    font-size: 12px;
    color: var(--foreground, currentColor);
  }

  .tab-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    font-style: italic;
  }

  .layer-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--foreground, currentColor);
  }

  .layer-row {
    min-height: 64px;
    border: 1px solid;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    padding: 12px 18px;
    color: var(--foreground, currentColor);
  }

  .layer-left {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }

  .layer-label {
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.3px;
    color: var(--layer-accent, var(--foreground, currentColor));
  }

  .layer-tools {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.5px;
    opacity: 0.75;
    color: var(--layer-accent, var(--foreground, currentColor));
    white-space: normal;
    word-break: break-word;
  }

  .badge {
    font-size: 11px;
    font-weight: 700;
    border: 1px solid;
    border-radius: 3px;
    padding: 1px 4px;
    flex-shrink: 0;
    color: var(--foreground, currentColor);
    border-color: var(--foreground, currentColor);
  }

  /* Harness text and number tags use the same red */
  .harness-layer .layer-label,
  .harness-layer .layer-tools,
  .harness-layer .badge {
    color: var(--layer-accent);
  }

  .harness-layer .badge {
    border-color: var(--layer-accent);
  }

  /* Data Origination uses the default foreground */
  .data-origination .layer-label,
  .data-origination .layer-tools,
  .data-origination .badge {
    color: var(--foreground, currentColor);
  }

  .data-origination .badge {
    border-color: var(--foreground, currentColor);
  }

  @media (max-width: 480px) {
    .frame-governance {
      padding: 14px 10px 10px 10px;
    }

    .frame-harness {
      padding: 10px 8px 8px 8px;
    }

    .layer-row {
      padding: 10px 12px;
      justify-content: flex-start;
    }

    .layer-tools {
      flex-basis: 100%;
      text-align: left;
      margin-left: calc(14px + 24px);
    }
  }
</style>